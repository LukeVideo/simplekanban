FROM nginx:latest

# Copy the Nginx template configuration
COPY nginx.conf.template /etc/nginx/nginx.conf.template

# Copy static frontend files (adjust path if needed)
COPY html /usr/share/nginx/html

# Expose port 80
EXPOSE 80

# Substitute API_HOST, wait 30s, start Nginx
CMD ["sh", "-c", "envsubst '\\$API_HOST' < /etc/nginx/nginx.conf.template > /etc/nginx/nginx.conf && sleep 30 && nginx -g 'daemon off;'"]